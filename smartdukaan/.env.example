# =============================================================================
# Smart Dukaan — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# The server validates these at startup and refuses to boot if any required
# value is missing. Secret values are never logged or returned by the API.
# =============================================================================

# --- REQUIRED ---------------------------------------------------------------

# PostgreSQL / Supabase connection string used by the server ONLY.
# Local development example (matches the local Postgres set up in this repo):
#   postgresql://smartdukaan:smartdukaan_local_dev@127.0.0.1:5432/smartdukaan_dev
# Supabase example (use the "Connection string" from Project Settings → Database):
#   postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://smartdukaan:smartdukaan_local_dev@127.0.0.1:5432/smartdukaan_dev"

# Secret used to sign and verify JWT access/refresh tokens (server-side only).
# Use a long random string (>= 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-characters"

# --- OPTIONAL (sensible defaults applied if omitted) ------------------------

# Server HTTP port.
PORT="4000"

# Node environment: development | test | production
NODE_ENV="development"

# Comma-separated list of allowed origins for CORS (with credentials).
# Dev web app: http://localhost:3000
# Production: your web domain, e.g. https://app.smartdukaan.pk
# Native apps (Capacitor): https://localhost (Android), capacitor://localhost (iOS)
CORS_ORIGIN="http://localhost:3000"

# Access-token lifetime (e.g. 15m, 1h) and refresh-token lifetime (e.g. 30d).
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# Separate DB used by the automated test suite (integration tests).
TEST_DATABASE_URL="postgresql://smartdukaan:smartdukaan_local_dev@127.0.0.1:5432/smartdukaan_test"

# --- WEB APP (dev only, safe to expose — NOT a secret) ----------------------
# The browser always calls the API on the SAME ORIGIN at /api (so the httpOnly
# refresh cookie is first-party). In development the Vite dev server proxies
# /api and /health to this target. In production, serve the built web app
# behind the same host/reverse-proxy as the API. Defaults to localhost:4000.
VITE_API_TARGET="http://localhost:4000"
